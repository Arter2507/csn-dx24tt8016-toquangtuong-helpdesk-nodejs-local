# Sao chép thành .env rồi điền giá trị thật. Không commit .env.

NODE_ENV=development
PORT=3000

# demo = dữ liệu bộ nhớ (không cần MySQL)
# mysql = dữ liệu MySQL, cần đăng nhập
DATA_SOURCE=demo

# --- MySQL (mysql2 + Prisma) ---
# Tạo database bằng một trong hai cách:
#   A) Import sql/helpdesk-schema.sql bằng DBeaver / Navicat
#   B) pnpm exec prisma migrate deploy (cần DATABASE_URL đúng)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=helpdesk
DB_USER=root
DB_PASSWORD=

# Prisma dùng DATABASE_URL. Thay PASSWORD bằng mật khẩu MySQL của bạn.
# Ví dụ không mật khẩu: mysql://root@localhost:3306/helpdesk
DATABASE_URL=mysql://root:PASSWORD@localhost:3306/helpdesk

# --- Auth MySQL (tạo bí mật ngẫu nhiên tối thiểu 32 byte) ---
JWT_SECRET=
REFRESH_TOKEN_DAYS=7

# --- App ---
CORS_ORIGIN=http://127.0.0.1:4200
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
