// Trạm Hỗ Trợ — Prisma schema map 1-1 với sql/helpdesk-schema.sql
// Runtime API hiện vẫn dùng mysql2; Prisma phục vụ migrate/seed/B1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  email        String    @unique @db.VarChar(254)
  username     String?   @unique(map: "uq_users_username") @db.VarChar(32)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  activationTokenHash String? @unique(map: "uq_users_activation_token_hash") @map("activation_token_hash") @db.Char(64)
  activationExpiresAt DateTime? @map("activation_expires_at") @db.DateTime(3)
  passwordResetTokenHash String? @unique(map: "uq_users_password_reset_token_hash") @map("password_reset_token_hash") @db.Char(64)
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at") @db.DateTime(3)
  fullName     String    @map("full_name") @db.VarChar(150)
  phone        String?   @db.VarChar(30)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @map("updated_at") @db.DateTime(3)

  roles                 UserRole[]
  sessions              AuthSession[]
  technicianCategories  TechnicianCategory[]
  ticketsRequested      Ticket[]             @relation("TicketRequester")
  ticketsAssigned       Ticket[]             @relation("TicketAssignee")
  comments              TicketComment[]
  attachmentsUploaded   TicketAttachment[]
  eventsActed           TicketEvent[]
  notifications         Notification[]

  profile UserProfile?
  organizationMembership OrganizationMember?
  ownedOrganization Organization? @relation("OrganizationOwner")
  tasksAssigned TaskItem[] @relation("TaskAssignee")
  tasksCreated TaskItem[] @relation("TaskCreator")

  @@map("users")
}

enum MemberRole {
  OWNER
  ADMIN
  TECHNICIAN
  USER
}

model Organization {
  id          Int      @id @db.UnsignedTinyInt
  name        String   @db.VarChar(150)
  code        String   @unique @db.VarChar(30)
  description String   @default("") @db.VarChar(1000)
  ownerId     BigInt?  @unique @map("owner_id") @db.UnsignedBigInt
  createdAt   DateTime @map("created_at") @db.DateTime(3)

  owner       User?    @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  members     OrganizationMember[]
  units       OrganizationUnit[]
  slaSettings SlaSettings?

  @@map("organizations")
}

model OrganizationUnit {
  id             BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId Int     @map("organization_id") @db.UnsignedTinyInt
  parentId       BigInt? @map("parent_id") @db.UnsignedBigInt
  code           String  @db.VarChar(30)
  name           String  @db.VarChar(100)
  isActive       Boolean @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_org_units_org")
  parent OrganizationUnit? @relation("UnitTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_org_units_parent")
  children OrganizationUnit[] @relation("UnitTree")
  members OrganizationMember[]

  @@unique([organizationId, code], map: "uq_org_units_code")
  @@unique([organizationId, id], map: "uq_org_units_id")
  @@index([organizationId, parentId], map: "idx_org_units_parent")
  @@map("organization_units")
}

model OrganizationMember {
  userId         BigInt     @id @map("user_id") @db.UnsignedBigInt
  organizationId Int       @map("organization_id") @db.UnsignedTinyInt
  employeeCode   String?    @map("employee_code") @db.VarChar(40)
  department     String     @default("") @db.VarChar(100)
  unitId         BigInt?    @map("unit_id") @db.UnsignedBigInt
  position       String     @default("") @db.VarChar(100)
  customerTier   CustomerTier @default(STANDARD) @map("customer_tier")
  role           MemberRole
  joinedAt       DateTime   @map("joined_at") @db.DateTime(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit OrganizationUnit? @relation(fields: [organizationId, unitId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_members_unit")

  @@unique([organizationId, employeeCode], map: "uq_members_employee_code")
  @@index([organizationId, role], map: "idx_members_org_role")
  @@index([organizationId, unitId], map: "idx_members_unit")
  @@map("organization_members")
}

enum CustomerTier {
  STANDARD
  VIP
}

model SlaSettings {
  organizationId Int @id @map("organization_id") @db.UnsignedTinyInt
  policy Json
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sla_organization")

  @@map("sla_settings")
}

model Role {
  id   BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  code String @unique @db.VarChar(30)
  name String @db.VarChar(100)

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  roleId    BigInt   @map("role_id") @db.UnsignedBigInt
  createdAt DateTime @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, roleId])
  @@index([roleId, userId], map: "idx_user_roles_role_user")
  @@map("user_roles")
}

model AuthSession {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId           BigInt    @map("user_id") @db.UnsignedBigInt
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt        DateTime  @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt], map: "idx_auth_sessions_user_revoked")
  @@map("auth_sessions")
}

model Category {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code      String   @unique @db.VarChar(30)
  name      String   @db.VarChar(100)
  parentId  BigInt? @map("parent_id") @db.UnsignedBigInt
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @map("created_at") @db.DateTime(3)
  updatedAt DateTime @map("updated_at") @db.DateTime(3)

  technicians TechnicianCategory[]
  tickets     Ticket[]
  articles    KnowledgeArticle[]
  parent      Category? @relation("ServiceCatalog", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fk_categories_parent")
  children    Category[] @relation("ServiceCatalog")

  @@index([parentId], map: "idx_categories_parent")
  @@map("categories")
}

model KnowledgeArticle {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  categoryId BigInt? @map("category_id") @db.UnsignedBigInt
  title String @db.VarChar(200)
  body String @db.Text
  visibility KnowledgeVisibility @default(INTERNAL)
  updatedAt DateTime @default(now()) @map("updated_at") @db.DateTime(3)
  archivedAt DateTime? @map("archived_at") @db.DateTime(3)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fk_kb_category")

  @@index([categoryId], map: "idx_kb_category")
  @@fulltext([title, body], map: "ft_kb_content")
  @@map("knowledge_articles")
}

enum KnowledgeVisibility {
  PUBLIC
  INTERNAL
}

model TechnicianCategory {
  userId     BigInt   @map("user_id") @db.UnsignedBigInt
  categoryId BigInt   @map("category_id") @db.UnsignedBigInt
  createdAt  DateTime @map("created_at") @db.DateTime(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, categoryId])
  @@index([categoryId, userId], map: "idx_technician_categories_category_user")
  @@map("technician_categories")
}

model Ticket {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  displayCode String    @unique(map: "uq_tickets_display_code") @map("display_code") @db.VarChar(40)
  requesterId BigInt    @map("requester_id") @db.UnsignedBigInt
  assigneeId  BigInt?   @map("assignee_id") @db.UnsignedBigInt
  categoryId  BigInt    @map("category_id") @db.UnsignedBigInt
  title       String    @db.VarChar(200)
  description String    @db.Text
  priority    String    @db.VarChar(10)
  status      String    @db.VarChar(20)
  version     Int       @default(1) @db.UnsignedInt
  resolvedAt  DateTime? @map("resolved_at") @db.DateTime(3)
  responseDueAt DateTime? @map("response_due_at") @db.DateTime(3)
  resolutionDueAt DateTime? @map("resolution_due_at") @db.DateTime(3)
  firstResponseAt DateTime? @map("first_response_at") @db.DateTime(3)
  responseWarningDueAt DateTime? @map("response_warning_due_at") @db.DateTime(3)
  resolutionWarningDueAt DateTime? @map("resolution_warning_due_at") @db.DateTime(3)
  closedAt    DateTime? @map("closed_at") @db.DateTime(3)
  archivedAt  DateTime? @map("archived_at") @db.DateTime(3)
  createdAt   DateTime  @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @map("updated_at") @db.DateTime(3)

  requester   User               @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignee    User?              @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  comments    TicketComment[]
  attachments TicketAttachment[]
  events      TicketEvent[]
  notifications Notification[]

  @@index([requesterId, createdAt, id], map: "idx_tickets_requester_created")
  @@index([assigneeId, status, createdAt, id], map: "idx_tickets_assignee_status_created")
  @@index([status, createdAt, id], map: "idx_tickets_status_created")
  @@index([responseDueAt], map: "idx_tickets_response_due")
  @@index([resolutionDueAt], map: "idx_tickets_resolution_due")
  @@index([categoryId, createdAt, id], map: "idx_tickets_category_created")
  @@map("tickets")
}

model TicketNumberRule {
  categoryId BigInt @id @map("category_id") @db.UnsignedBigInt
  prefix     String @default("") @db.VarChar(12)
  nextNumber Int    @default(1) @map("next_number") @db.UnsignedInt
  digits     Int    @default(4) @db.UnsignedTinyInt
  suffix     String @default("") @db.VarChar(12)

  @@map("ticket_number_rules")
}

model TicketComment {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  ticketId  BigInt   @map("ticket_id") @db.UnsignedBigInt
  authorId  BigInt   @map("author_id") @db.UnsignedBigInt
  body      String   @db.Text
  isInternal Boolean @default(false) @map("is_internal")
  createdAt DateTime @map("created_at") @db.DateTime(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([ticketId, createdAt, id], map: "idx_ticket_comments_ticket_created")
  @@map("ticket_comments")
}

model TicketAttachment {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  ticketId     BigInt   @map("ticket_id") @db.UnsignedBigInt
  uploaderId   BigInt   @map("uploader_id") @db.UnsignedBigInt
  originalName String   @map("original_name") @db.VarChar(255)
  storageKey   String   @unique @map("storage_key") @db.VarChar(255)
  archivedAt   DateTime? @map("archived_at") @db.DateTime(3)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt   @map("size_bytes") @db.UnsignedBigInt
  createdAt    DateTime @map("created_at") @db.DateTime(3)

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploader User   @relation(fields: [uploaderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([ticketId, createdAt, id], map: "idx_ticket_attachments_ticket_created")
  @@map("ticket_attachments")
}

model TicketEvent {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  ticketId  BigInt   @map("ticket_id") @db.UnsignedBigInt
  actorId   BigInt   @map("actor_id") @db.UnsignedBigInt
  eventType String   @map("event_type") @db.VarChar(30)
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  note      String?  @db.Text
  createdAt DateTime @map("created_at") @db.DateTime(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([ticketId, createdAt, id], map: "idx_ticket_events_ticket_created")
  @@map("ticket_events")
}

model TicketStatusMail {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  ticketId BigInt @map("ticket_id") @db.UnsignedBigInt
  ticketCode String @map("ticket_code") @db.VarChar(40)
  userId BigInt @map("user_id") @db.UnsignedBigInt
  ticketStatus String @map("ticket_status") @db.VarChar(20)
  attempts Int @default(0) @db.UnsignedSmallInt
  availableAt DateTime @default(now()) @map("available_at") @db.DateTime(3)
  sentAt DateTime? @map("sent_at") @db.DateTime(3)
  failedAt DateTime? @map("failed_at") @db.DateTime(3)

  @@index([sentAt, failedAt, availableAt, id], map: "idx_ticket_status_mail_ready")
  @@map("ticket_status_mail")
}

model InboundTicketMail {
  fingerprint String @id @db.Char(64)
  ticketId BigInt? @map("ticket_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("inbound_ticket_mail")
}

model Notification {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  ticketId  BigInt?   @map("ticket_id") @db.UnsignedBigInt
  type      String    @db.VarChar(30)
  title     String    @db.VarChar(200)
  body      String    @db.VarChar(500)
  readAt    DateTime? @map("read_at") @db.DateTime(3)
  createdAt DateTime  @map("created_at") @db.DateTime(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, readAt, createdAt, id], map: "idx_notifications_user_read_created")
  @@map("notifications")
}

model UserProfile {
  userId BigInt @id @map("user_id") @db.UnsignedBigInt
  details Json
  avatar Bytes? @db.MediumBlob
  avatarMime String? @map("avatar_mime") @db.VarChar(32)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@map("user_profiles")
}

model TaskItem {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  title String @db.VarChar(160)
  description String @db.Text
  status String @db.VarChar(10)
  dueDate DateTime? @map("due_date") @db.Date
  assigneeId BigInt? @map("assignee_id") @db.UnsignedBigInt
  createdBy BigInt @map("created_by") @db.UnsignedBigInt
  version Int @default(1) @db.UnsignedInt
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator User @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([assigneeId], map: "task_items_assignee_idx")
  @@index([createdBy], map: "task_items_creator_idx")
  @@map("task_items")
}
